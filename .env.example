# Conexión a Supabase (G-Quota)
# Copia este archivo como .env.local y completa con los valores reales de tu proyecto.
# Encuéntralos en el panel de Supabase: Project Settings > API.

# URL del proyecto de Supabase (ej. https://xxxxxxxx.supabase.co)
VITE_GQUOTA_SUPABASE_URL=

# Clave pública anónima (anon / public key)
VITE_GQUOTA_SUPABASE_ANON_KEY=
